FROM python:3.12-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends tini rdiff-backup procps tzdata && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --uid 1000 --create-home app

WORKDIR /app

COPY app/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./
COPY docker/entrypoint.sh /entrypoint.sh
RUN mkdir -p data source destination && chmod -R a+rX /app && chown app:app data source destination

EXPOSE 8686

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8686/health')"]

ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8686"]
